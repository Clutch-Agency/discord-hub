{
  "name": "discord-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:bot\"",
    "dev:web": "dotenv -e .env -- next dev",
    "dev:bot": "node bot/index.js",
    "prebuild": "npm run prisma:generate",
    "build": "next build",
    "start": "concurrently \"npm run start:web\" \"npm run start:bot\"",
    "start:web": "dotenv -e .env -- next start",
    "start:bot": "node bot/index.js",
    "deploy:commands": "node bot/deploy-commands.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "node scripts/run-postgres-integration-tests.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^6.19.3",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^1.27.0",
    "next": "^15.1.0",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "^6.19.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4",
    "concurrently": "^10.0.4",
    "dotenv-cli": "^7.4.4",
    "eslint": "^9",
    "eslint-config-next": "^15.5.22",
    "tailwindcss": "^4",
    "vitest": "^4.1.10"
  }
}
